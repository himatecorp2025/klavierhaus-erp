# Public website / Nyilvános weboldal
PORT=10000
WEBSITE_BASE_URL=https://klavierhaus.onrender.com

# Keep false while the website uses the temporary Render address.
# A Render tesztcím használata alatt maradjon false értéken.
WEBSITE_ALLOW_INDEXING=false

# Read-only public ERP API base URL. The zero stage does not call it yet.
# A csak olvasható nyilvános ERP API alapcíme. A nulladik szakasz még nem hívja meg.
ERP_PUBLIC_API_URL=https://klavierhaus-erp.onrender.com
