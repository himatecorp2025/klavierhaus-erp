# Application / Alkalmazás
PORT=3030
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# Persistent storage / Tartós tárhely
DB_PATH=./server/db/klavierhaus_v6.sqlite
BACKUP_DIR=./server/backups
UPLOAD_DIR=./server/uploads

# Web Push (copy the already configured production values; do not regenerate them during an ordinary deployment)
# Web Push (normál telepítéskor a már működő éles értékeket másold át; ne generáld újra őket)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@klavierhaus.com

# Protects the reminder scan endpoint / Az emlékeztető-vizsgálati végpont védelme
CRON_SECRET=replace-with-a-random-cron-secret

# Google Calendar -> ERP (one-way, read-only) / Google Naptár -> ERP (egyirányú, csak olvasás)
# Create an OAuth 2.0 Web application in Google Cloud and add this redirect URI:
# Hozz létre Google Cloud OAuth 2.0 webalkalmazást, és add hozzá ezt az átirányítási URI-t:
# https://YOUR-RENDER-DOMAIN/api/google-calendar/oauth/callback
APP_BASE_URL=https://YOUR-RENDER-DOMAIN
# Separate public website used by event invitations / Külön nyilvános weboldal az eseménymeghívásokhoz
WEBSITE_BASE_URL=https://klavierhaus-home.onrender.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Use a separate random secret of at least 32 characters. Do not reuse JWT_SECRET.
# Külön, legalább 32 karakteres véletlen titok legyen. Ne használd újra a JWT_SECRET értékét.
GOOGLE_TOKEN_ENCRYPTION_KEY=
GOOGLE_CALENDAR_CENTRAL_EMAIL=klavierhauswork@gmail.com
GOOGLE_CALENDAR_ID=klavierhauswork@gmail.com
GOOGLE_CALENDAR_POLL_INTERVAL_MS=120000
GOOGLE_CALENDAR_INITIAL_LOOKBACK_DAYS=30
# Optional override. APP_BASE_URL normally creates this value automatically.
# Opcionális felülírás. Az APP_BASE_URL ezt normál esetben automatikusan létrehozza.
# GOOGLE_REDIRECT_URI=https://YOUR-RENDER-DOMAIN/api/google-calendar/oauth/callback
# GOOGLE_CALENDAR_WEBHOOK_URL=https://YOUR-RENDER-DOMAIN/api/google-calendar/webhook

# Transactional account activation email (Resend) / Tranzakciós fiókaktiváló e-mail (Resend)
# Verify klavierhaus.com in Resend before using this sender.
# A feladó használata előtt hitelesítsd a klavierhaus.com domaint a Resendben.
RESEND_API_KEY=
EMAIL_FROM=Klavierhaus Accounts <accounts@klavierhaus.com>
EVENT_EMAIL_FROM=Klavierhaus Events <events@klavierhaus.com>
# Optional reply address / Opcionális válaszcím
EMAIL_REPLY_TO=
# Resend webhook signing secret (starts with whsec_)
# Resend webhook-aláírási titok (whsec_ kezdetű)
RESEND_WEBHOOK_SECRET=

# Dedicated signing secret for event admission QR codes (32+ random characters).
# Eseménybeléptetési QR-kódok külön aláírási titka (legalább 32 véletlen karakter).
# If omitted, JWT_SECRET is used as a deployment-safe fallback. A separate value is recommended.
# Ha hiányzik, a rendszer telepítésbiztos tartalékként a JWT_SECRET értékét használja. Külön érték ajánlott.
EVENT_QR_SECRET=

# Stripe Sandbox only: live keys are rejected by the application.
# Kizárólag Stripe tesztüzem: az alkalmazás elutasítja az éles kulcsokat.
STRIPE_SECRET_KEY=sk_test_replace_with_your_stripe_sandbox_secret
# Create a webhook endpoint for https://YOUR-ERP-DOMAIN/api/webhooks/stripe
# Hozz létre webhook-végpontot: https://YOUR-ERP-DOMAIN/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=whsec_replace_with_your_stripe_webhook_secret
